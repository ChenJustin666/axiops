{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "workload",
    "image",
    "service",
    "resources"
  ],
  "properties": {
    "workload": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "Deployment",
            "StatefulSet",
            "DaemonSet",
            "Job",
            "CronJob"
          ]
        }
      }
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "image": {
      "type": "object",
      "required": [
        "repository",
        "tag"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "$ref": "#/definitions/name"
          }
        }
      }
    },
    "resources": {
      "type": "object",
      "properties": {
        "requests": {
          "$ref": "#/definitions/resources"
        },
        "limits": {
          "$ref": "#/definitions/resources"
        }
      }
    },
    "env": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "value": {
            "type": "string"
          },
          "valueFrom": {
            "type": "object"
          }
        },
        "oneOf": [
          {
            "required": [
              "value"
            ],
            "not": {
              "required": [
                "valueFrom"
              ]
            }
          },
          {
            "required": [
              "valueFrom"
            ],
            "not": {
              "required": [
                "value"
              ]
            }
          }
        ]
      }
    },
    "envFrom": {
      "type": "array",
      "items": {
        "type": "object",
        "oneOf": [
          {
            "required": [
              "secretRef"
            ],
            "not": {
              "required": [
                "configMapRef"
              ]
            }
          },
          {
            "required": [
              "configMapRef"
            ],
            "not": {
              "required": [
                "secretRef"
              ]
            }
          }
        ]
      }
    },
    "command": {
      "$ref": "#/definitions/strings"
    },
    "args": {
      "$ref": "#/definitions/strings"
    },
    "initContainers": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/container"
      }
    },
    "sidecars": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/container"
      }
    },
    "podAnnotations": {
      "$ref": "#/definitions/stringMap"
    },
    "podLabels": {
      "$ref": "#/definitions/stringMap"
    },
    "podSecurityContext": {
      "type": "object"
    },
    "securityContext": {
      "type": "object"
    },
    "nodeSelector": {
      "$ref": "#/definitions/stringMap"
    },
    "tolerations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "affinity": {
      "type": "object"
    },
    "topologySpreadConstraints": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 0
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^$|^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
        },
        "automountServiceAccountToken": {
          "type": "boolean"
        },
        "annotations": {
          "$ref": "#/definitions/stringMap"
        }
      }
    },
    "rbac": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "apiGroups",
              "resources",
              "verbs"
            ],
            "properties": {
              "apiGroups": {
                "$ref": "#/definitions/strings"
              },
              "resources": {
                "$ref": "#/definitions/strings"
              },
              "verbs": {
                "$ref": "#/definitions/strings"
              }
            }
          }
        }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "type": {
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "port": {
          "$ref": "#/definitions/port"
        },
        "targetPort": {
          "$ref": "#/definitions/port"
        },
        "nodePort": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 65535
        },
        "annotations": {
          "$ref": "#/definitions/stringMap"
        }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "labels": {
          "$ref": "#/definitions/stringMap"
        },
        "annotations": {
          "$ref": "#/definitions/stringMap"
        },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "host",
              "paths"
            ],
            "properties": {
              "host": {
                "$ref": "#/definitions/hostname"
              },
              "paths": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "path",
                    "pathType"
                  ],
                  "properties": {
                    "path": {
                      "type": "string",
                      "pattern": "^/"
                    },
                    "pathType": {
                      "enum": [
                        "Prefix",
                        "Exact",
                        "ImplementationSpecific"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "tls": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "hosts"
            ],
            "properties": {
              "hosts": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/definitions/hostname"
                }
              },
              "secretName": {
                "$ref": "#/definitions/name"
              }
            }
          }
        }
      }
    },
    "probes": {
      "type": "object",
      "properties": {
        "readiness": {
          "$ref": "#/definitions/probe"
        },
        "liveness": {
          "$ref": "#/definitions/probe"
        },
        "startup": {
          "$ref": "#/definitions/probe"
        }
      }
    },
    "monitoring": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "port": {
          "$ref": "#/definitions/port"
        }
      }
    },
    "autoscaling": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "maxReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "targetCPUUtilizationPercentage": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "targetMemoryUtilizationPercentage": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "behavior": {
          "type": "object"
        }
      }
    },
    "pdb": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minAvailable": {
          "$ref": "#/definitions/budget"
        },
        "maxUnavailable": {
          "$ref": "#/definitions/budget"
        }
      }
    },
    "persistence": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "existingClaim": {
          "type": "string"
        },
        "size": {
          "type": "string",
          "minLength": 1
        },
        "storageClass": {
          "type": [
            "string",
            "null"
          ]
        },
        "accessModes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "ReadWriteOnce",
              "ReadOnlyMany",
              "ReadWriteMany",
              "ReadWriteOncePod"
            ]
          }
        },
        "mountPath": {
          "type": "string",
          "pattern": "^/"
        },
        "retain": {
          "type": "boolean"
        },
        "readOnly": {
          "type": "boolean"
        }
      }
    },
    "configMaps": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/definitions/suffix"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]+$"
            },
            "additionalProperties": {
              "type": "string"
            }
          },
          "mountPath": {
            "type": "string",
            "pattern": "^/"
          }
        }
      }
    },
    "secrets": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/definitions/suffix"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": {
            "enum": [
              "Opaque",
              "kubernetes.io/tls",
              "kubernetes.io/basic-auth",
              "kubernetes.io/ssh-auth"
            ]
          },
          "stringData": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]+$"
            },
            "additionalProperties": {
              "type": "string"
            }
          },
          "fields": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "additionalProperties": {
              "type": "object",
              "required": [
                "key",
                "value"
              ],
              "properties": {
                "key": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.-]+$"
                },
                "value": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "secretMounts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "mountPath"
        ],
        "properties": {
          "name": {
            "$ref": "#/definitions/name"
          },
          "mountPath": {
            "type": "string",
            "pattern": "^/"
          },
          "optional": {
            "type": "boolean"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "key",
                "path"
              ],
              "properties": {
                "key": {
                  "type": "string",
                  "minLength": 1
                },
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "allOf": [
                    {
                      "not": {
                        "pattern": "^/"
                      }
                    },
                    {
                      "not": {
                        "pattern": "(^|/)\\.\\.(/|$)"
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "volumes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ]
      }
    },
    "volumeMounts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "mountPath"
        ]
      }
    },
    "statefulSet": {
      "type": "object",
      "properties": {
        "podManagementPolicy": {
          "enum": [
            "OrderedReady",
            "Parallel"
          ]
        },
        "updateStrategy": {
          "type": "object"
        },
        "volumeClaimTemplates": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "deployment": {
      "type": "object",
      "properties": {
        "strategy": {
          "type": "object"
        },
        "progressDeadlineSeconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "daemonSet": {
      "type": "object",
      "properties": {
        "updateStrategy": {
          "type": "object"
        }
      }
    },
    "job": {
      "type": "object",
      "properties": {
        "restartPolicy": {
          "enum": [
            "OnFailure",
            "Never"
          ]
        },
        "backoffLimit": {
          "type": "integer",
          "minimum": 0
        },
        "activeDeadlineSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "ttlSecondsAfterFinished": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "cronJob": {
      "type": "object",
      "properties": {
        "schedule": {
          "type": "string",
          "minLength": 1
        },
        "suspend": {
          "type": "boolean"
        },
        "concurrencyPolicy": {
          "enum": [
            "Allow",
            "Forbid",
            "Replace"
          ]
        },
        "successfulJobsHistoryLimit": {
          "type": "integer",
          "minimum": 0
        },
        "failedJobsHistoryLimit": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "policyTypes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "Ingress",
              "Egress"
            ]
          }
        },
        "ingress": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "egress": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    }
  },
  "definitions": {
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
    },
    "suffix": {
      "type": "string",
      "minLength": 1,
      "maxLength": 56,
      "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
    },
    "hostname": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^(\\*\\.)?[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)*$"
    },
    "stringMap": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "strings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number"
        ]
      }
    },
    "container": {
      "type": "object",
      "required": [
        "name",
        "image"
      ],
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 63,
          "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
        },
        "image": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "budget": {
      "type": [
        "integer",
        "string",
        "null"
      ],
      "minimum": 0,
      "pattern": "^(100|[0-9]{1,2})%$"
    },
    "probe": {
      "type": "object",
      "properties": {
        "httpGet": {
          "type": "object",
          "required": [
            "port",
            "path"
          ],
          "properties": {
            "port": {
              "oneOf": [
                {
                  "$ref": "#/definitions/port"
                },
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 15,
                  "pattern": "^[a-z]([a-z0-9-]*[a-z0-9])?$"
                }
              ]
            },
            "path": {
              "type": "string",
              "pattern": "^/"
            },
            "scheme": {
              "enum": [
                "HTTP",
                "HTTPS"
              ]
            }
          }
        },
        "tcpSocket": {
          "type": "object",
          "required": [
            "port"
          ],
          "properties": {
            "port": {
              "oneOf": [
                {
                  "$ref": "#/definitions/port"
                },
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 15,
                  "pattern": "^[a-z]([a-z0-9-]*[a-z0-9])?$"
                }
              ]
            }
          }
        },
        "exec": {
          "type": "object",
          "required": [
            "command"
          ],
          "properties": {
            "command": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            }
          }
        },
        "grpc": {
          "type": "object",
          "required": [
            "port"
          ],
          "properties": {
            "port": {
              "$ref": "#/definitions/port"
            },
            "service": {
              "type": "string"
            }
          }
        },
        "initialDelaySeconds": {
          "type": "integer",
          "minimum": 0
        },
        "periodSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "failureThreshold": {
          "type": "integer",
          "minimum": 1
        },
        "successThreshold": {
          "type": "integer",
          "minimum": 1
        }
      },
      "oneOf": [
        {
          "maxProperties": 0
        },
        {
          "required": [
            "httpGet"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "tcpSocket"
                ]
              },
              {
                "required": [
                  "exec"
                ]
              },
              {
                "required": [
                  "grpc"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "tcpSocket"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "httpGet"
                ]
              },
              {
                "required": [
                  "exec"
                ]
              },
              {
                "required": [
                  "grpc"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "exec"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "tcpSocket"
                ]
              },
              {
                "required": [
                  "httpGet"
                ]
              },
              {
                "required": [
                  "grpc"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "grpc"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "tcpSocket"
                ]
              },
              {
                "required": [
                  "exec"
                ]
              },
              {
                "required": [
                  "httpGet"
                ]
              }
            ]
          }
        }
      ]
    }
  }
}
